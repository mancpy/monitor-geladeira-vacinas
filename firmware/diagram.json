    { "type": "board-ds18b20", "id": "temp1", "top": 20, "left": 210, "attrs": { "temperature": "5" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 90, "left": 150, "rotate": 90, "attrs": { "value": "4700" } },
